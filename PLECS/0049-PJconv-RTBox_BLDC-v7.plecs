    Component {
      Type          ConfigurableSubsystem
      Name          "VSI1"
      Show          on
      Position      [305, 155]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-100, -70; 100, 70]
      SampleTime    "-1"
      CodeGenDiscretizationMethod "2"
      CodeGenTarget "Generic"
      MaskType      "3-Phase Voltage Source Inverter"
      MaskDescription "This power module implements a 3-phase 2-level voltage "
"source inverter. It offers two configurations:\n"
"\n"
"- Switched: Ideal switches are used to model the individual power semiconduct"
"ors. The control inputs are instantaneous logical gate signals \n"
"\n"
"- Sub-cycle average: The component is modeled with controlled voltage and cur"
"rent sources. The control inputs are the relative on-times of the semiconduct"
"ors with values between 0 and 1. The gate signals can be either instantaneous"
" (using only values 0 and 1) or time-averaged."
      MaskHelp      "qthelp:///powermodule_vsi.html"
      MaskDisplay   "local function drawSwitch(x, y, symbol)\n"
"  Icon:line(Vector{0, 0}+x,\n"
"            Vector{-25, -10}+y)\n"
"  Icon:line(Vector{0, 0}+x,\n"
"            Vector{10, 25}+y)\n"
"  if symbol == \"2\" then\n"
"    Icon:line(Vector{0, -10}+x,\n"
"              Vector{-10, -10}+y)\n"
"    Icon:line(Vector{-10, 0}+x,\n"
"              Vector{10, 10}+y)\n"
"    Icon:line(Vector{-10, -10}+x,\n"
"              Vector{-13, -7}+y)\n"
"    Icon:line(Vector{-10, -10}+x,\n"
"              Vector{-3, 3}+y)\n"
"    Icon:line(Vector{-10, -10}+x,\n"
"              Vector{13, 7}+y)\n"
"    Icon:line(Vector{-15, -15}+x,\n"
"              Vector{10, -10}+y)\n"
"    Icon:line(Vector{-15, -20}+x,\n"
"              Vector{0, 0}+y)\n"
"    Icon:line(Vector{-10, 0, 0}+x,\n"
"              Vector{0, 0, 10}+y)\n"
"    Icon:line(Vector{-4, -8, -4}+x,\n"
"              Vector{2, 0, -2}+y)\n"
"  else\n"
"    Icon:line(Vector{0, -10}+x,\n"
"              Vector{-10, -4}+y)\n"
"    Icon:line(Vector{-10, 0}+x,\n"
"              Vector{4, 10}+y)\n"
"    Icon:line(Vector{-10, -10}+x,\n"
"              Vector{8, -8}+y)\n"
"    Icon:line(Vector{-14, -14}+x,\n"
"              Vector{8, -8}+y)\n"
"    Icon:line(Vector{-5.65, -1.667, -3.864}+x,\n"
"              Vector{8.634, 9, 5.658}+y)\n"
"    Icon:line(Vector{-14, -20}+x,\n"
"              Vector{0, 0}+y)\n"
"  end\n"
"  Icon:line(Vector{0, 10, 10}+x,\n"
"            Vector{-14, -14, -6}+y)\n"
"  Icon:line(Vector{10, 10, 0}+x,\n"
"            Vector{6, 14, 14}+y)\n"
"  Icon:line(Vector{3, 17}+x,\n"
"            Vector{-6, -6}+y)\n"
"  Icon:line(Vector{10, 17, 3, 10}+x,\n"
"            Vector{-6, 6, 6, -6}+y)\n"
"end\n"
"\n"
"local symbol = Dialog:get('semiSymbol');\n"
"\n"
"drawSwitch(-80, -40, symbol)\n"
"drawSwitch(-80, 40, symbol)\n"
"drawSwitch(0, -40, symbol)\n"
"drawSwitch(0, 40, symbol)\n"
"drawSwitch(80, -40, symbol)\n"
"drawSwitch(80, 40, symbol)\n"
"\n"
"Icon:line({-100, 80}, {-65, -65})\n"
"Icon:line({-100, 80}, {65, 65})\n"
"\n"
"Icon:line({-80, -80}, {-15, 15})\n"
"Icon:line({-80, 100}, {-10, -10})\n"
"Icon:circle(-80, -65, 1)\n"
"Icon:circle(-80, -10, 1)\n"
"Icon:circle(-80, 65, 1)\n"
"\n"
"Icon:line({0, 0}, {-15, 15})\n"
"Icon:line({0, 100}, {0, 0})\n"
"Icon:circle(0, -65, 1)\n"
"Icon:circle(0, 0, 1)\n"
"Icon:circle(0, 65, 1)\n"
"\n"
"Icon:line({80, 80}, {-15, 15})\n"
"Icon:line({80, 100}, {10, 10})\n"
"Icon:circle(80, 10, 1)\n"
