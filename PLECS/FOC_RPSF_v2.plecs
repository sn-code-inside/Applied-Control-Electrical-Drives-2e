  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "ADC_fsV=45.02 % (V) fullscale ADC voltage\nADC_fsC=4"
"7.7 % (A)  fullscaleADC current\nf_LPF=381.8 %(Hz) converter LPF cnr freq\nta"
"uLPvolt = 1/(2*pi*f_LPF);\nfs=10e3 % controller sam[ple freq (Hz)\nTs=1/fs \n"
"f_PWM=10e3\nfsp=1e3 % sample frequency speed controller\nTsp=1/fsp\nwb=100 % "
"speed loop bandwidth (rad/s)\n%%%%%%%%%%%%%%%%%%%%%%%\n%% Observer (estimator"
")\ng = 600;\n%%%%%%%%%%%%%%%%%%%%\n% PI speed and position compensator for es"
"timator \nzeta = 2.0;\t\t\t\t\t\t\t\t\t%\tdamping\nwn = 200;\t\t\t\t\t\t\t\t"
"\t%\tnatural frequency\nKep = 2*zeta*wn;\t\t\t\t\t\t\t%\tproportional gain\nK"
"ei = wn*wn;\t\t\t\t\t\t\t\t%\tintegral gain\nK1 = 2*zeta*wn + wn;\t\t\t\t\t\t"
"%\tgain 1\nK2 = wn*wn + 2*zeta*wn*wn;\t\t\t\t% \tgain 2\nK3 = wn*wn*wn;\t\t\t"
"\t\t\t\t\t%\tgain 3\nfcw = 1/(2*pi*200);\t\t\t\t\t\t%\tcutoff frequency low-p"
"ass filter\n%%%%%%%%%%%%%%%%\nid_Rs=1.5% id injection current (A)\n%Teknic mo"
"tor\nLd=180e-6 % \nLq=180e-6 \nRs=0.41\np=4 % pole pair\nPsi_M = 6.42e-3 % PM"
" flux (Wb)\nJ=0.07e-3 %inertia Kgm2"
  InitialState  "1"
  SystemState   ""
  TaskingMode   "1"
  TaskConfigurations ""
  CodeGenParameterInlining "2"
  CodeGenFloatingPointFormat "2"
