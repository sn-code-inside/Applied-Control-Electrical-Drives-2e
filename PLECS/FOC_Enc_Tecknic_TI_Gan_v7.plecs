        Component {
          Type          CScript
          Name          "Reconstruct\nContinuous\nRamp"
          Show          on
          Position      [120, 80]
          Direction     up
          Flipped       off
          LabelPosition south
          Parameter {
            Variable      "DialogGeometry"
            Value         "[656 316 588 359]"
            Show          off
