"s\n"
"quant = 2*pi/ticks;\n"
"if(coding == 1)\n"
"\tTtable = [0 0; 1 1; 0 1; 1 0];\n"
"else\n"
"\tTtable = [0 0; 1 1; 1 0; 0 1];\n"
"end\n"
