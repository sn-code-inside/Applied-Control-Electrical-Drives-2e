            Variable      "DirectFeedthrough"
            Value         "1"
            Show          off
          }
          Parameter {
            Variable      "Ts"
            Value         "[0, 0; -1, 0]"
            Show          off
          }
          Parameter {
            Variable      "TerminalBasedSampleTimes"
            Value         "1"
            Show          off
          }
          Parameter {
            Variable      "Parameters"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "LangStandard"
            Value         "2"
            Show          off
          }
          Parameter {
            Variable      "GnuExtensions"
            Value         "2"
            Show          off
          }
          Parameter {
            Variable      "RuntimeCheck"
            Value         "2"
            Show          off
          }
          Parameter {
            Variable      "HighlightLevel"
            Value         "0"
            Show          off
          }
          Parameter {
            Variable      "Declarations"
            Value         "#include <stdio.h>\n"
"#include <math.h>\n"
"\n"
"#define first DiscState(0)\n"
"#define lastSampleHit DiscState(1)\n"
"#define lastPhi DiscState(2)\n"
"\n"
"static double dT;\n"
"static double dXdT;"
            Show          off
          }
          Parameter {
            Variable      "StartFcn"
            Value         "first = 1;\n"
"lastSampleHit = 0;\n"
"lastPhi = 0;\n"
"\n"
"dT = SampleTimePeriod(1);\n"
"dXdT = 0;"
            Show          off
          }
          Parameter {
            Variable      "OutputFcn"
            Value         "if (dT != 0)\n"
"{\n"
"   if (IsMajorStep && first)\n"
"   {\n"
"      lastPhi = InputSignal(0,0);\n"
"   }\n"
"   if (IsSampleHit(1))\n"
"   {\n"
"\t  double dX = InputSignal(0,0) - lastPhi;\n"
"\t  if (dX > M_PI)\n"
"\t  {\n"
"\t    dX -= 2*M_PI;\n"
"\t    lastPhi += 2*M_PI;\n"
"\t  }\n"
"\t  if (dX < -M_PI)\n"
"\t  {\n"
"\t    dX += 2*M_PI;\n"
"\t    lastPhi -= 2*M_PI;\n"
"\t  }\n"
"\t  dXdT = dX/dT;\n"
"   }\n"
"   Output(0) = dXdT * (CurrentTime - lastSampleHit) + lastPhi - dXdT*dT;\n"
"}\n"
"else\n"
"{\n"
"   Output(0) = InputSignal(0,0);\n"
"}\n"
            Show          off
          }
          Parameter {
            Variable      "UpdateFcn"
            Value         "if (IsSampleHit(1))\n"
"{\n"
"   lastPhi = InputSignal(0,0);\n"
"   lastSampleHit = CurrentTime;\n"
"}\n"
"first = 0;"
            Show          off
          }
          Parameter {
            Variable      "DerivativeFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "TerminateFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "StoreCustomStateFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "RestoreCustomStateFcn"
            Value         ""
            Show          off
          }
        }
