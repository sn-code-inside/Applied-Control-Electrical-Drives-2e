"n=1.0% winding ratio aux to run\np=1% pole pair\nJ=14.6e-4 %inertia Kgm2\nPsi"
"=0.9% rotor flux (Wb) at 1A id\n%8301HC\nADC_fsV=409.9 % (V) fullscale ADC vo"
"ltage\nADC_fsC=20 % (A)  fullscaleADC current\nf_LPF=379.6 %(Hz) converter LP"
"F cnr freq\ntauLPvolt = 1/(2*pi*f_LPF); %hardware LPF timeconstant\n%%control"
"ler\nfs=10e3 % controller sample freq (Hz)\nf_PWM=10e3 % PWM frequency (Hz)\n"
"Ts=1/fs\n"
